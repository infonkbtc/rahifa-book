rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Security Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'info.nkbtc@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Entity Validation Blueprints ---
    function isValidBook(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.author is string && data.author.size() >= 1 && data.author.size() <= 100 &&
             data.categoryId is string && isValidId(data.categoryId) &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 60 &&
             data.description is string && data.description.size() <= 2000 &&
             data.coverUrl is string && data.coverUrl.size() <= 1000 &&
             data.pdfUrl is string && data.pdfUrl.size() >= 1 && data.pdfUrl.size() <= 1000 &&
             data.published is bool &&
             data.featured is bool &&
             data.pageCount is int && data.pageCount >= 0 && data.pageCount <= 50000 &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.description is string && data.description.size() <= 300 &&
             (!('bookCount' in data) || (data.bookCount is int && data.bookCount >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- Books Collection ---
    match /books/{bookId} {
      // Normal users may read/list only published books; Admins may read/list all books.
      allow get, list: if existing().published == true || isAdmin();

      allow create: if isAdmin() &&
                       isValidId(bookId) &&
                       isValidBook(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().keys().hasAll([
                         'title', 'author', 'categoryId', 'categoryName',
                         'description', 'coverUrl', 'pdfUrl',
                         'published', 'featured', 'pageCount',
                         'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'author', 'categoryId', 'categoryName',
                         'description', 'coverUrl', 'pdfUrl',
                         'published', 'featured', 'pageCount',
                         'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       exists(/databases/$(database)/documents/categories/$(incoming().categoryId));

      allow update: if isAdmin() &&
                       isValidId(bookId) &&
                       isValidBook(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       exists(/databases/$(database)/documents/categories/$(incoming().categoryId)) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'author', 'categoryId', 'categoryName',
                         'description', 'coverUrl', 'pdfUrl',
                         'published', 'featured', 'pageCount', 'updatedAt'
                       ]);

      allow delete: if isAdmin() && isValidId(bookId);
    }

    // --- Categories Collection ---
    match /categories/{categoryId} {
      allow get, list: if true;

      allow create: if isAdmin() &&
                       isValidId(categoryId) &&
                       isValidCategory(incoming()) &&
                       incoming().keys().hasAll(['name', 'description', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'description', 'bookCount', 'createdAt', 'updatedAt']);

      allow update: if isAdmin() &&
                       isValidId(categoryId) &&
                       isValidCategory(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'bookCount', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // --- Announcements Collection ---
    match /announcements/{announcementId} {
      allow get, list: if existing().active == true || isAdmin();

      allow create: if isAdmin() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming()) &&
                       incoming().keys().hasAll(['title', 'message', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'message', 'active', 'createdAt', 'updatedAt']);

      allow update: if isAdmin() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'active', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // --- Admins Registry ---
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }
  }
}
